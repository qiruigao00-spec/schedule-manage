.page { padding:32rpx 24rpx 180rpx; }.hero { display:flex;align-items:center;justify-content:space-between;padding:18rpx 10rpx 30rpx; }
.eyebrow { font-size:20rpx;letter-spacing:4rpx;color:#9A968B; }.title { font-size:52rpx;font-weight:700;margin-top:6rpx;letter-spacing:-2rpx; }
.page button.today-btn { display:flex;align-items:center;justify-content:center;flex-shrink:0;box-sizing:border-box;width:112rpx;min-width:0;height:64rpx;margin:0;padding:0;line-height:1.2;border-radius:32rpx;background:#242522;color:white;font-size:26rpx; }
.filters { white-space:nowrap;margin-bottom:24rpx; }.filter-row { display:inline-flex;gap:14rpx;padding:0 4rpx; }
.filter { height:66rpx;padding:0 28rpx;border-radius:34rpx;background:#EDEAE3;display:flex;align-items:center;gap:10rpx;color:#69675F;font-size:26rpx; }
.filter.active { background:#242522;color:white; }.filter-dot { width:14rpx;height:14rpx;border-radius:50%; }
.calendar-card { background:#FFF;border-radius:30rpx;padding:28rpx 10rpx 22rpx;box-shadow:0 16rpx 50rpx rgba(41,38,30,.06);overflow:hidden; }
.month-bar { display:flex;align-items:center;justify-content:space-between;padding:0 8rpx 24rpx; }
.page button.month-trigger { display:flex;align-items:center;justify-content:center;gap:20rpx;box-sizing:border-box;width:auto;min-width:0;height:76rpx;margin:0;padding:0 16rpx;background:transparent;border-radius:16rpx;line-height:1.2;color:#242522; }
.month-label { font-size:40rpx;font-weight:700;white-space:nowrap; }
.month-caret { flex-shrink:0;box-sizing:border-box;width:18rpx;height:18rpx;margin-top:-8rpx;border-right:5rpx solid #45463F;border-bottom:5rpx solid #45463F;transform:rotate(45deg); }
.mask.month-mask { z-index:20; }
.month-sheet { width:100%;box-sizing:border-box;padding:18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#FFF; }
.month-picker-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx; }
.month-picker-title { font-size:34rpx;font-weight:600;color:#242522; }
.page button.picker-cancel,.page button.picker-confirm { display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:112rpx;min-width:0;height:72rpx;margin:0;padding:0;border-radius:18rpx;line-height:1.2;font-size:30rpx; }
.page button.picker-cancel { background:transparent;color:#69675F; }
.page button.picker-confirm { background:#242522;color:#FFF;font-weight:600; }
.picker-column-labels { display:flex;padding-bottom:12rpx;font-size:26rpx;color:#77746C;text-align:center; }
.picker-column-labels text { flex:1; }
.month-wheel { width:100%;height:440rpx; }
.month-option { display:flex;align-items:center;justify-content:center;height:104rpx;line-height:104rpx;font-size:40rpx;color:#77746C; }
.month-option-selected { font-size:44rpx;font-weight:700;color:#242522; }
.arrow { width:70rpx;height:62rpx;line-height:54rpx;text-align:center;font-size:54rpx;color:#69675F; }.week-head,.week { display:grid;grid-template-columns:repeat(7,1fr); }
.week-head text { text-align:center;font-size:25rpx;font-weight:600;color:#8D8980;padding:12rpx 0 20rpx; }.day { min-height:150rpx;box-sizing:border-box;padding:10rpx 3rpx;border-top:1rpx solid #ECEAE4;overflow:hidden; }
.day-number { width:48rpx;height:48rpx;line-height:48rpx;text-align:center;font-size:29rpx;font-weight:600;margin:0 auto 8rpx;border-radius:50%; }.day-number.today { background:#242522;color:white;font-weight:700; }
.marks { display:flex;flex-direction:column;gap:5rpx; }.mark { height:28rpx;border-radius:7rpx;color:white;font-size:20rpx;font-weight:600;line-height:28rpx;text-align:center;overflow:hidden;white-space:nowrap; }
.loading,.empty-state { text-align:center;padding:100rpx 20rpx;color:#99968C;font-size:26rpx; }
.page button.fab { position:fixed;right:34rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:112rpx;min-width:112rpx;max-width:112rpx;height:112rpx;min-height:112rpx;max-height:112rpx;margin:0;padding:0;line-height:1;border-radius:50%;background:#E67E5F;color:white;box-shadow:0 12rpx 28rpx rgba(181,83,57,.24);z-index:5; }
.fab-icon { position:relative;display:block;width:40rpx;height:40rpx;pointer-events:none; }
.fab-icon::before,.fab-icon::after { content:"";position:absolute;top:50%;left:50%;background:currentColor;border-radius:3rpx;transform:translate(-50%,-50%); }
.fab-icon::before { width:36rpx;height:5rpx; }
.fab-icon::after { width:5rpx;height:36rpx; }
.page button.fab-hover { background:#D97052; }
.mask { position:fixed;inset:0;background:rgba(20,20,18,.38);z-index:10;display:flex;align-items:flex-end; }.sheet { width:100%;max-height:75vh;overflow-y:auto;background:#F9F8F4;border-radius:36rpx 36rpx 0 0;padding:14rpx 30rpx 34rpx;box-sizing:border-box; }
.sheet-handle { width:72rpx;height:8rpx;background:#D7D3CA;border-radius:4rpx;margin:0 auto 28rpx; }.sheet-head { display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx; }
.sheet-title { font-size:36rpx;font-weight:700; }.sheet-sub { font-size:24rpx;color:#99968C;margin-top:5rpx; }.page button.add-btn { display:flex;align-items:center;justify-content:center;flex-shrink:0;box-sizing:border-box;width:144rpx;min-width:0;height:64rpx;margin:0;padding:0;line-height:1.2;background:#242522;color:white;border-radius:32rpx;font-size:24rpx; }
.schedule-item { display:flex;align-items:stretch;background:white;border-radius:20rpx;margin-bottom:16rpx;overflow:hidden;min-height:126rpx; }.color-bar { width:10rpx; }.schedule-main { flex:1;padding:22rpx; }
.schedule-name { font-size:30rpx;font-weight:650; }.schedule-name text { font-size:21rpx;color:#8D8A82;font-weight:400;margin-left:10rpx; }.schedule-meta,.schedule-note { color:#68655E;font-size:24rpx;margin-top:8rpx; }.schedule-note { color:#99958C; }.chevron { display:flex;align-items:center;padding:0 22rpx;font-size:40rpx;color:#B8B4AA; }
