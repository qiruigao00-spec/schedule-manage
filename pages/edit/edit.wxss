.page { padding:34rpx 28rpx 80rpx; }.intro { padding:10rpx 8rpx 30rpx; }.title { font-size:46rpx;font-weight:700; }.sub { color:#8B887F;font-size:24rpx;margin-top:10rpx; }
.form-card { background:white;border-radius:28rpx;padding:0 28rpx;box-shadow:0 16rpx 50rpx rgba(41,38,30,.05); }.field { padding:28rpx 0;border-bottom:1rpx solid #EFEEE9; }
.field.last { border:0; }.label { font-size:24rpx;color:#858178;margin-bottom:14rpx; }.label text { color:#D65F4A; }.picker-value,input { height:66rpx;line-height:66rpx;font-size:31rpx;color:#282824; }
.picker-value { display:flex;align-items:center; }.picker-value text { margin-left:auto;color:#B0ACA3;font-size:40rpx; }.person-dot { width:18rpx;height:18rpx;border-radius:50%;margin-right:14rpx; }
textarea { width:100%;height:160rpx;font-size:29rpx;line-height:1.6; }
.page button.save,.page button.delete { display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-width:0;height:100rpx;margin:28rpx 0 0;padding:0 32rpx;line-height:1.2;text-align:center;border-radius:24rpx;font-size:30rpx;font-weight:600; }
.page button.save { background:#242522;color:#FFF; }
.page button.save[disabled] { background:#75756F;color:#DDD; }
.page button.delete { background:#F1E5E1;color:#C85340;margin-top:18rpx; }
.date-mask { position:fixed;inset:0;z-index:20;background:rgba(20,20,18,.38);display:flex;align-items:flex-end; }
.date-sheet { width:100%;box-sizing:border-box;padding:18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#FFF; }
.date-sheet-handle { width:72rpx;height:8rpx;background:#D7D3CA;border-radius:4rpx;margin:0 auto 28rpx; }
.date-picker-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx; }
.date-picker-title { font-size:34rpx;font-weight:600;color:#242522; }
.page button.picker-cancel,.page button.picker-confirm { display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex-shrink:0;width:112rpx;min-width:0;height:72rpx;margin:0;padding:0;border-radius:18rpx;line-height:1.2;font-size:30rpx; }
.page button.picker-cancel { background:transparent;color:#69675F; }
.page button.picker-confirm { background:#242522;color:#FFF;font-weight:600; }
.picker-column-labels { display:flex;padding-bottom:12rpx;font-size:26rpx;color:#77746C;text-align:center; }
.picker-column-labels text { flex:1; }
.date-wheel { width:100%;height:440rpx; }
.date-option { display:flex;align-items:center;justify-content:center;height:104rpx;line-height:104rpx;font-size:40rpx;color:#77746C; }
.date-option-selected { font-size:44rpx;font-weight:700;color:#242522; }
.photographer-options { padding:0 8rpx 12rpx; }
.page button.photographer-option { display:flex;align-items:center;box-sizing:border-box;width:100%;min-width:0;height:112rpx;margin:0 0 16rpx;padding:0 28rpx;border:2rpx solid #EEECE6;border-radius:22rpx;background:#F8F7F3;line-height:1.2;text-align:left;color:#242522; }
.page button.photographer-option-selected { border-color:#242522;background:#EFEEE7; }
.photographer-color { flex-shrink:0;width:24rpx;height:24rpx;margin-right:22rpx;border-radius:50%; }
.photographer-name { flex:1;font-size:40rpx;font-weight:600; }
.photographer-option-selected .photographer-name { font-weight:700; }
.photographer-check { position:relative;box-sizing:border-box;flex-shrink:0;width:40rpx;height:40rpx;border:2rpx solid #B6B3AA;border-radius:50%; }
.photographer-check-selected { border-color:#242522;background:#242522; }
.photographer-check-selected::after { content:"";position:absolute;left:12rpx;top:6rpx;width:9rpx;height:18rpx;border-right:4rpx solid #FFF;border-bottom:4rpx solid #FFF;transform:rotate(45deg); }
